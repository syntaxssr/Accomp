{
  "name": "accomp-marketing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern docs",
    "typecheck": "tsc --noEmit",
    "format:check": "node scripts/check-format.mjs",
    "test:source": "node --test tests/foundation.test.mjs tests/i18n.test.mjs tests/marketing-content.test.mjs tests/motion.test.mjs tests/production-readiness.test.mjs tests/release-automation.test.mjs tests/release-readiness.test.mjs tests/roadmap.test.mjs tests/seo.test.mjs tests/support.test.mjs tests/widgets.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test": "npm run test:source && npm run build && npm run test:render",
    "audit:release": "node scripts/release-audit.mjs",
    "preflight:status": "node scripts/production-preflight.mjs",
    "preflight:production": "node scripts/production-preflight.mjs --strict",
    "smoke:site": "node scripts/site-smoke.mjs",
    "smoke:local": "node scripts/local-production-smoke.mjs",
    "package:release": "node scripts/package-release.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run audit:release",
    "check:release": "npm run check && npm run smoke:local"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
